<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Password reset</title>
</head>
<body style="margin:0;padding:0;background:#f3f7f1;font-family:Arial,Helvetica,sans-serif;color:#1f2a22;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3f7f1;margin:0;padding:0;">
    <tr>
      <td align="center" style="padding:32px 16px;">

        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
               style="max-width:600px;background:#ffffff;border:1px solid #dbe7d8;border-radius:18px;overflow:hidden;">

          <tr>
            <td style="background:#184f2f;padding:36px 32px;">
              <div style="text-align:center;color:#ffffff;font-size:24px;line-height:30px;font-weight:800;">
                Kairos Garden
              </div>
            </td>
          </tr>

          <tr>
            <td style="padding:40px 32px 10px 32px;">

              <h1 style="margin:0 0 24px 0;
                         font-size:28px;
                         line-height:36px;
                         color:#1f2a22;
                         font-weight:800;
                         text-align:left;">
                Reset your password
              </h1>

              <p style="margin:0;
                        font-size:16px;
                        line-height:25px;
                        color:#26352a;">
                We received a request to reset the password for your Kairos Garden account.
              </p>

              <p style="margin:16px 0 0 0;
                        font-size:15px;
                        line-height:24px;
                        color:#5b6a5f;">
                Click the button below to choose a new password. If you did not request this, you can safely ignore this email.
              </p>

            </td>
          </tr>

          <tr>
            <td align="center" style="padding:30px 32px 34px 32px;">
              <a href="{{model.link}}"
                 style="display:inline-block;
                        background:#157a42;
                        color:#ffffff;
                        text-decoration:none;
                        font-size:16px;
                        line-height:20px;
                        font-weight:800;
                        padding:15px 26px;
                        border-radius:12px;">
                Reset password
              </a>
            </td>
          </tr>

          <tr>
            <td style="padding:24px 32px;
                       background:#fbfdf9;
                       border-top:1px solid #e4eee1;">

              <p style="margin:0;
                        font-size:12px;
                        line-height:18px;
                        color:#7a867c;
                        text-align:center;">
                This message was sent by Kairos Garden to help secure your account.
              </p>

              <p style="margin:8px 0 0 0;
                        font-size:12px;
                        line-height:18px;
                        color:#9aa39c;
                        text-align:center;">
                Please do not reply to this automated email.
              </p>

            </td>
          </tr>

        </table>

        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:600px;">
          <tr>
            <td align="center" style="padding:18px 20px 0 20px;">
              <p style="margin:0;font-size:12px;line-height:18px;color:#7c8a80;">
                Kairos Garden
              </p>
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>
</body>
</html>
